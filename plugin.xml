<?xml version="1.0" encoding="UTF-8"?>
<plugin id="@globules-io/cordova-plugin-unzip"
        version="1.0.0"
        xmlns="http://apache.org/cordova/ns/plugins/1.0"
        xmlns:android="http://schemas.android.com/apk/res/android">
     <name>Unzip</name>
      <engines>
          <engine name="cordova" version=">=10.0.0" />
          <engine name="cordova-android" version=">=10.1.1" />
          <engine name="cordova-ios" version=">=7.0.0" />
     </engines>
     <js-module src="www/Unzip.js" name="Unzip">
          <clobbers target="Unzip" />
     </js-module>
     <!-- ANDROID -->
     <platform name="android">
          <config-file target="res/xml/config.xml" parent="/*">
               <feature name="Unzip">
                    <param name="android-package" value="io.globules.unzip.Unzip" />
                    <param name="onload" value="true"/>
               </feature>
          </config-file>
          <source-file src="src/android/Unzip.kt" target-dir="src/main/java/io/globules/unzip" />
     </platform>
     <!-- iOS -->
     <platform name="ios">          
          <config-file target="config.xml" parent="/*">
               <feature name="Unzip">
                    <param name="ios-package" value="Unzip"/>
                    <param name="onload" value="true"/>
               </feature>
          </config-file>
          <source-file src="src/ios/Unzip.swift" />
          <podspec>
               <pods>
                    <pod name="ZIPFoundation" spec="~> 0.9.13" />
               </pods>
          </podspec>
     </platform>
</plugin>